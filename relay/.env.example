# Settings for docker-compose.yml in this folder: copy this file to .env and edit it.
# docs/HOSTING.md, "From the repo". .env stays on your machine (git ignores it).

# --- Required ---------------------------------------------------------------------------------------------------------

# The DNS name of this server: an A (and AAAA) record pointing at this machine. Players connect to wss://NAME/fed.
RELAY_DOMAIN=relay.example.net

# For Let's Encrypt's expiry warnings. Setting it means you accept the Let's Encrypt subscriber agreement
# (https://letsencrypt.org/repository/): certbot runs non-interactively with --agree-tos. Read it first.
LETSENCRYPT_EMAIL=you@example.net

# --- Your server (used on the first start, when the server is founded) -----------------------------------------------
# Changing these later does not change the server: its record is signed. The relay's log then says what differs and the
# command that changes it (docker compose exec relay /relay ops server --name …).

# The name players see. Unique in the server list.
RELAY_NAME=Packet Lunch

# Who it syncs with: open (any server that is not standalone), selective (servers you list) or standalone (your
# players only see each other).
RELAY_SYNC=open

# Languages spoken, comma separated.
RELAY_LANGS=en

# A short description, up to 280 characters.
RELAY_DESC=

# --- A second node of an existing server, instead of founding one -----------------------------------------------------
# The server's identity and the wss:// URL of one of its running nodes. The log then prints the add-node command for
# that server's operators.
RELAY_JOIN=
RELAY_JOIN_FROM=

# --- Ports ------------------------------------------------------------------------------------------------------------

# Players connect here (TLS, served by the relay itself).
RELAY_HTTPS_PORT=443
# certbot answers Let's Encrypt here. Let's Encrypt always checks port 80 from outside: another number only works with a
# forward from 80.
RELAY_HTTP_PORT=80

# The node's public URL. Only when players reach it on another port than 443: wss://relay.example.net:8443/fed
# RELAY_URL=

# --- Monitoring and notices -------------------------------------------------------------------------------------------

# Prometheus metrics, reachable on the Compose network only (empty: off). To read them from this machine, uncomment the
# 127.0.0.1:9100 line under the relay's ports in docker-compose.yml; never publish them to the internet.
RELAY_METRICS=0.0.0.0:9100

# An https:// webhook called once per new relay release (empty: off). Applied on every start.
RELAY_NOTIFY_URL=

# Log as JSON lines.
RELAY_LOG_JSON=false

# --- Images and testing -----------------------------------------------------------------------------------------------

# The relay's image: `docker compose up -d --build` builds this checkout into it; `docker compose pull` fetches a
# release instead. Pin one with ghcr.io/fjaeckel/seriesoftubes-relay:X.Y.Z.
RELAY_IMAGE=ghcr.io/fjaeckel/seriesoftubes-relay:latest
# The version a checkout build reports (dev: no update notices).
RELAY_VERSION=dev

CERTBOT_IMAGE=certbot/certbot:latest

# true: certificates from Let's Encrypt's staging service (not trusted by browsers, generous rate limits) while you try
# the setup. Set it back to false and `docker compose up -d`: the staging certificate is replaced.
CERTBOT_STAGING=false
